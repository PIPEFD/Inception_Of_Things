# Copia a .env y rellena con las credenciales reales del Service Principal
# (ver docs/decisiones.md — ADR sobre auth no interactiva de Azure).
# .env NUNCA se versiona (ver .gitignore).
#
# Generar el SP (scoped solo al resource group, no a toda la suscripción):
#   az ad sp create-for-rbac --name "sp-iot-42-terraform" --role Contributor \
#     --scopes "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-iot-42"

ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_TENANT_ID=
ARM_SUBSCRIPTION_ID=

# ── Opcional: overrides de rutas/config local ──────────────────────
# El Makefile las carga vía '-include .env' y sobreescriben su valor por
# defecto. Descomenta solo la que necesites cambiar -- si tu clave SSH,
# usuario o contraseña del vault viven en la ruta por defecto, no hace
# falta tocar nada de esto.
# SSH_KEY=/ruta/a/tu/clave_privada
# ADMIN_USER=azureuser
# VAULT_PASS_FILE=/ruta/a/tu/contraseña_del_vault
